@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main>
    <div class="login-bg">
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="login-card" id="loginCard" aria-label="Formulario de inicio de sesión (demo)">
            <div class="login-header">
                <h1>Bienvenido</h1>
                <p>Inicia sesión para continuar</p>
            </div>
            <!-- DEMO: no funcional. El submit está prevenido en la parte del JS -->
            <form id="frmLogin" class="login-form" autocomplete="on" action="#" method="post" novalidate>
                <div class="field">
                    <input type="text" class="input" placeholder=" " id="usuario" name="usuario" autocomplete="username" aria-label="Usuario" />
                    <label class="label" for="usuario">Usuario</label>
                    <span class="focus-ring"></span>
                    <small class="field-hint">Ej: admin</small>
                </div>
                <div class="field">
                    <input type="password" class="input" placeholder=" " id="clave" name="clave" autocomplete="current-password" aria-label="Contraseña" />
                    <label class="label" for="clave">Contraseña</label>
                    <button type="button" class="toggle-pass" aria-label="Mostrar/ocultar contraseña" title="Mostrar/ocultar" tabindex="-1">
                        <span class="eye"></span>
                    </button>
                    <span class="focus-ring"></span>
                </div>
                <div class="form-row">
                    <label class="chk">
                        <input type="checkbox" class="chk-input" id="rec" />
                        <span class="chk-box"></span>
                        <span>Recordarme</span>
                    </label>
                    <a href="#" class="link-muted" onclick="return false;">¿Olvidaste tu contraseña?</a>
                </div>
                <button type="submit" class="btn-primary" id="btnLogin">
                    <span class="btn-text">Entrar</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>
                <p class="demo-note">* Modo demostración: no envía datos ni valida contra servidor.</p>
            </form>
            <div class="login-footer">
                <small>Programación 2 UTEC — MVC EVALUACIÓN 3 (@DateTime.Now.Year)</small>
            </div>
        </div>
    </div>
    <style>
        :root {
            --bg1: #0f172a;
            --bg2: #111827;
            --c1: #7c3aed;
            --c2: #06b6d4;
            --c3: #f59e0b;
            --card-bg: rgba(255,255,255,.08);
            --card-brd: rgba(255,255,255,.18);
            --ring: rgba(124,58,237,.45);
            --txt: #e5e7eb;
            --muted: #9ca3af;
            --err: #ef4444;
        }

        * {
            box-sizing: border-box
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Roboto, Arial, sans-serif;
            color: var(--txt);
            background: radial-gradient(1200px 800px at 10% 10%, #0b1222, var(--bg1)), linear-gradient(120deg,var(--bg1),var(--bg2));
            overflow-x: hidden
        }

        .login-bg {
            position: relative;
            min-height: calc(100vh - 60px);
            display: grid;
            place-items: center;
            padding: 30px 12px;
        }

        .blob {
            position: absolute;
            filter: blur(60px);
            opacity: .35;
            mix-blend-mode: screen;
            animation: float 16s ease-in-out infinite;
        }

        .b1 {
            width: 560px;
            height: 560px;
            background: radial-gradient(closest-side, var(--c1), transparent);
            top: -10%;
            left: -5%;
            animation-delay: 0s;
        }

        .b2 {
            width: 520px;
            height: 520px;
            background: radial-gradient(closest-side, var(--c2), transparent);
            bottom: -15%;
            right: 5%;
            animation-delay: 3s;
        }

        .b3 {
            width: 480px;
            height: 480px;
            background: radial-gradient(closest-side, var(--c3), transparent);
            top: 40%;
            left: 55%;
            animation-delay: 6s;
        }

        @@keyframes float {
            0%, 100% {
                transform: translate3d(0,0,0)
            }

            50% {
                transform: translate3d(0,-20px,0)
            }
        }

        .login-card {
            width: min(440px, 94vw);
            background: var(--card-bg);
            border: 1px solid var(--card-brd);
            backdrop-filter: blur(14px) saturate(130%);
            border-radius: 22px;
            box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.06);
            padding: 28px 26px 22px;
            transform-style: preserve-3d;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .login-card:hover {
                box-shadow: 0 24px 80px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.06);
            }

        .login-header {
            text-align: center;
            margin-bottom: 18px;
        }

            .login-header h1 {
                margin: 0 0 6px;
                font-size: 28px;
                letter-spacing: .2px;
            }

            .login-header p {
                margin: 0;
                color: var(--muted);
            }

        .login-form {
            display: grid;
            gap: 16px;
        }

        .field {
            position: relative;
        }

        .input {
            width: 100%;
            padding: 16px 44px 16px 14px;
            color: var(--txt);
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 14px;
            outline: none;
            font-size: 15px;
            transition: border .2s, box-shadow .2s, background .2s;
        }

            .input:focus {
                border-color: var(--ring);
                box-shadow: 0 0 0 6px rgba(124,58,237,.12);
                background: rgba(255,255,255,.06);
            }

        .label {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
            transition: all .18s;
            background: transparent;
            padding: 0 6px;
        }

        .input:not(:placeholder-shown) + .label,
        .input:focus + .label {
            top: -8px;
            font-size: 12px;
            color: #c4b5fd;
            background: rgba(17,24,39,.85);
            border-radius: 8px;
        }

        .focus-ring {
            position: absolute;
            inset: -2px;
            border-radius: 16px;
            pointer-events: none;
            transition: opacity .25s;
            opacity: 0;
        }

        .input:focus ~ .focus-ring {
            opacity: 1;
            box-shadow: 0 0 0 2px var(--ring), 0 0 0 10px rgba(124,58,237,.10);
        }

        .field-hint {
            color: var(--muted);
            font-size: 12px;
            margin-top: 6px;
            display: block;
        }

        .toggle-pass {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            cursor: pointer;
            border-radius: 10px;
            display: grid;
            place-items: center;
            opacity: .8;
            transition: background .2s, opacity .2s;
        }

            .toggle-pass:hover {
                background: rgba(255,255,255,.06);
                opacity: 1;
            }

        .eye, .eye::before {
            width: 18px;
            height: 12px;
            border: 2px solid #cbd5e1;
            border-radius: 12px/8px;
            position: relative;
            display: block;
        }

            .eye::before {
                content: "";
                position: absolute;
                inset: 3px 5px;
                border-radius: 50%;
                background: #cbd5e1;
            }

        .toggle-pass.active .eye::before {
            background: transparent;
            border: 2px solid #cbd5e1;
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 4px;
        }

        .chk {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
        }

        .chk-input {
            display: none;
        }

        .chk-box {
            width: 18px;
            height: 18px;
            border-radius: 6px;
            border: 1px solid rgba(255,255,255,.35);
            position: relative;
            background: rgba(255,255,255,.06);
        }

        .chk-input:checked + .chk-box {
            background: linear-gradient(180deg, #7c3aed, #5b21b6);
            border-color: transparent;
        }

            .chk-input:checked + .chk-box::after {
                content: "";
                position: absolute;
                inset: 3px 5px 3px 4px;
                border: 2px solid #fff;
                border-top-color: transparent;
                border-left-color: transparent;
                transform: rotate(45deg);
            }

        .link-muted {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;
            opacity: .8;
        }

            .link-muted:hover {
                opacity: 1;
                text-decoration: underline;
            }

        .btn-primary {
            width: 100%;
            padding: 14px 16px;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            background: linear-gradient(90deg, #7c3aed, #06b6d4 60%, #f59e0b 120%);
            background-size: 200% 100%;
            color: white;
            font-weight: 600;
            letter-spacing: .3px;
            box-shadow: 0 10px 24px rgba(124,58,237,.25);
            position: relative;
            overflow: hidden;
            transition: transform .12s, box-shadow .2s, background-position .6s;
        }

            .btn-primary:hover {
                background-position: 100% 0;
                box-shadow: 0 14px 36px rgba(6,182,212,.28);
                transform: translateY(-1px);
            }

            .btn-primary:active {
                transform: translateY(0);
            }

        .btn-text {
            position: relative;
            z-index: 2;
        }

        .btn-spinner {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,.45);
            border-top-color: #fff;
            animation: spin 1s linear infinite;
            opacity: 0;
            transition: opacity .2s;
        }

        @@keyframes spin {
            to {
                transform: translateY(-50%) rotate(360deg);
            }
        }

        .btn-primary::after {
            content: "";
            position: absolute;
            left: var(--x,50%);
            top: var(--y,50%);
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.35);
            transform: translate(-50%, -50%);
            transition: width .5s ease, height .5s ease, opacity .7s ease;
            opacity: 0;
        }

        .btn-primary.ripple::after {
            width: 320px;
            height: 320px;
            opacity: .0;
        }

        .demo-note {
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            margin: 8px 0 0;
        }

        .login-footer {
            text-align: center;
            margin-top: 16px;
            color: var(--muted);
            font-size: 12px;
        }

        @@media (max-width: 420px) {
            .login-card {
                padding: 22px 18px;
            }

            .login-header h1 {
                font-size: 24px;
            }
        }
    </style>
    <script>
(function(){
            // Tilt 3D suave
            const card = document.getElementById('loginCard');
            let rect;
            const maxTilt = 8;
            function updateRect(){ rect = card.getBoundingClientRect(); }
            updateRect();
            window.addEventListener('resize', updateRect);
            card.addEventListener('mousemove', (e)=>{
                const x = e.clientX - rect.left, y = e.clientY - rect.top;
                const rx = ((y / rect.height) - .5) * -2 * maxTilt;
                const ry = ((x / rect.width)  - .5) *  2 * maxTilt;
                card.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
            });
            card.addEventListener('mouseleave', ()=> card.style.transform = 'rotateX(0) rotateY(0)');
            // Mostrar/ocultar contraseña
            const btnToggle = document.querySelector('.toggle-pass');
            const inputPass = document.getElementById('clave');
            btnToggle.addEventListener('click', ()=>{
                const visible = inputPass.getAttribute('type') === 'text';
                inputPass.setAttribute('type', visible ? 'password' : 'text');
                btnToggle.classList.toggle('active', !visible);
                inputPass.focus();
            });
            // Ripple y el  spinner al enviar (DEMO)
            const btn = document.getElementById('btnLogin');
            const form = document.getElementById('frmLogin');
            btn.addEventListener('click', (e)=>{
                const r = btn.getBoundingClientRect();
                btn.style.setProperty('--x', (e.clientX - r.left) + 'px');
                btn.style.setProperty('--y', (e.clientY - r.top) + 'px');
                btn.classList.add('ripple');
                setTimeout(()=> btn.classList.remove('ripple'), 500);
            });
            form.addEventListener('submit', (ev)=>{
                ev.preventDefault();                 // IMPORTANTE: no envía (modo demo nada más)
                btn.setAttribute('disabled','disabled');
                btn.querySelector('.btn-spinner').style.opacity = 1;
                // simulación de "cargando"
                setTimeout(()=>{
                    btn.removeAttribute('disabled');
                    btn.querySelector('.btn-spinner').style.opacity = 0;
                    alert('Demo: aquí iría tu lógica real de login.');
                }, 1200);
            });
})();
    </script>
</main>
